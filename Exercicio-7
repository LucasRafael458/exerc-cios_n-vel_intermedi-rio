#include <stdio.h>

int main()
{
    int numero, i;
    int divisores = 0;

    printf("Digite um numero inteiro positivo: ");
    scanf("%d", &numero);

    for (i = 1; i <= numero; i++)
    {
        if (numero % i == 0)
        {
            divisores++;
        }
    }

    if (numero > 1 && divisores == 2)
    {
        printf("O numero e primo.\n");
    }
    else
    {
        printf("O numero nao e primo.\n");
    }

    return 0;
}
